.docker/

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Generated media and training artifacts
static/videos/
static/training_data/
checkpoints/
# Source material for training runs. Kept locally; too large for git, and the
# licence on a given clip is not necessarily ours to redistribute.
My Training data/

# Runtime audit trail written by the BoundaryGuard
config/runtime_action_log.jsonl
config/rollback_manifest.json

# Benchmark result written by EdgeDiffusionOptimizer. Despite living under
# config/ nothing ever reads it back — it is an output, not an input — and it is
# rewritten with new timings on every run, so tracking it made the tree dirty
# after each `pytest`.
config/edge_optimization.json

# Tools written at runtime by the evolution engine
extensions/*.py
!extensions/__init__.py
